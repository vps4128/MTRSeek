# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the one that documents them and holds nothing secret.
!.env.example

# MaxMind GeoLite2 databases — deployment data, not source.
#
# They are tens of megabytes each, licensed to whoever downloaded them rather
# than to this repository, and republished weekly; a committed copy is stale
# within a month and wrong in a way nobody notices. Their paths are configured
# through MAXMIND_ASN_DB_PATH and MAXMIND_CITY_DB_PATH — see `.env.example`.
data/geoip/
*.mmdb

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
